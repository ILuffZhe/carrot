<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置：
  - logs/carrot.log       应用日志（与 data 同目录）
  - logs/operations.log   业务操作审计日志（积分流水、登记/撤销、兑换、奖励/类型管理等）
  均按天 + 大小滚动，保留 30 天，UTF-8 编码（中文日志）。
-->
<configuration>

    <property name="LOG_DIR" value="logs"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>
    <property name="OPS_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level - %msg%n"/>
    <property name="MAX_HISTORY" value="30"/>

    <!-- 控制台（保持原有输出习惯） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 应用日志文件 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/carrot.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/carrot.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <createParentDirectories>true</createParentDirectories>
    </appender>

    <!-- 业务操作审计日志（独立文件，便于追溯） -->
    <appender name="OPS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/operations.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/operations.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${OPS_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <createParentDirectories>true</createParentDirectories>
    </appender>

    <!-- 业务操作日志走独立 logger，不向应用日志重复输出 -->
    <logger name="OPERATION" level="INFO" additivity="false">
        <appender-ref ref="OPS"/>
    </logger>

    <!-- 默认：控制台 + 应用文件 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
